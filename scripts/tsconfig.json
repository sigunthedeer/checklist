{
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "outDir": "../.validate",
    "rootDir": "..",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./validate-data.ts", "../src/data/**/*.ts"]
}
