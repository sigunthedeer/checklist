{
  "name": "checkride",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "validate:data": "tsc -p scripts/tsconfig.json && node .validate/scripts/validate-data.js",
    "build:web": "expo export -p web --output-dir dist --clear && node scripts/finalize-web.mjs dist",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.15",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.20",
    "expo-constants": "^57.0.17",
    "expo-haptics": "^57.0.2",
    "expo-keep-awake": "^57.0.1",
    "expo-linking": "^57.0.9",
    "expo-router": "^57.0.19",
    "expo-splash-screen": "^57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.10",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
